{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": [
        "eslint:recommended",
        "prettier"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "rules": {
        "semi": [
            "error",
            "always"
        ],
        "quotes": [
            "error",
            "double"
        ]
    },
    "ignorePatterns": [
        "dist/",
        "*.html",
        "*.css"
    ],
    "overrides": [
        {
            "files": [
                "scripts/*.js",
                "scripts/*.cjs"
            ],
            "rules": {
                "@typescript-eslint/no-var-requires": "off",
                "no-undef": "off"
            }
        },
        {
            "files": [
                "src/tests/**/*.js",
                "playwright.config.js"
            ],
            "env": {
                "node": true
            }
        }
    ]
}
