{
  "name": "conorhinchee.com",
  "version": "3.0.0",
  "description": "Conor Hinchee's Home Page",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test-ui": "playwright test --ui",
    "lint": "prettier . --write && eslint .",
    "report": "playwright show-report",
    "resume": "node --experimental-strip-types --no-warnings=ExperimentalWarning ./scripts/build-resume.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conor-Hinchee/Conor-Hinchee.github.io.git"
  },
  "author": "Conor Hinchee",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Conor-Hinchee/Conor-Hinchee/issues"
  },
  "homepage": "https://www.conorhinchee.com",
  "devDependencies": {
    "@axe-core/playwright": "^4.7.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.53.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "htmlnano": "^2.0.4",
    "jiti": "^2.7.0",
    "posthtml": "^0.16.6",
    "posthtml-modules": "^0.9.1",
    "prettier": "3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "type": "module"
}
